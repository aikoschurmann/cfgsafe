// README quick-start schema (with a few extra constraints). Checked by `make test`.
schema Database {
  host: string { default: "localhost" }
  port: int    { 
    default: 5432
    range: 1..65535
    env: "DB_PORT" 
  }

  password: string { 
    secret: true 
    required: true 
  }
}

schema Config {
  service_name: string { 
    required: true 
    pattern: "^[a-z0-9-]+$" 
  }
  db: Database {}
}
