import "integration_hooks.h"

schema GithubSource {
    url: string
    tag: string
    target: string
    options: string[]
}

schema NestedConfig {
    nested_id: int { 
        default: 99 
        hook: "test_nested_hook"
    }
    active: bool { 
        default: true 
        short: "a"
    }
}

schema TestSuite {
    project_name: string {
        required: true
        min_length: 3
        pattern: "^[A-Za-z0-9_-]+$"
    }
    
    version: int {
        default: 1
        range: 1..100
        short: "v"
    }

    api_key: string {
        secret: true
        default: "super-secret-key"
    }
    
    section level1 {
        factor: float {
            default: 0.5
            min: 0.0
            max: 1.0
        }
        
        section level2 {
            bind_addr: ipv4 {
                default: "127.0.0.1"
                env: "BIND_ADDR"
            }
            
            section level3 {
                debug_mode: bool {
                    default: false
                }
                
                log_file: path {
                    exists: true
                    required_if: debug_mode == true
                }
                
                section level4 {
                    depth: int {
                        default: 4
                    }
                    tags: string[] {
                        min_length: 1
                        hook: "test_array_hook"
                    }
                }
            }
        }
    }

    global_level: enum(DEBUG, INFO, WARN, ERROR) {
        default: INFO
    }
}

schema EdgeCaseTest {
    empty_str: string { default: "" }
    space_str: string { default: " " }
    tricky_str: string { default: "say \"hi\" C:\\dir\ttab ??=" }
    empty_default: string { default: "" }
    
    // Boolean stress
    flag_true: bool { default: false }
    flag_1: bool { default: false }
    flag_false: bool { default: true }
    flag_0: bool { default: true }

    hook_field: string {
        hook: "test_hook"
        default: "hook-ok"
    }

    int_array: int[] {
        min_length: 2
    }

    tiny: float { default: 0.00000012, range: 0.0000001..0.0000002 }
    pin: int { secret: true }
    pins: int[] { secret: true }
    float_array: float[]
    bool_array: bool[]
    ip_array: ipv4[]

    sources: GithubSource[]

    // Cross reference
    sub: NestedConfig {}
    
    section weird {
        // Deeply nested under schema
        key_with_dash: string { default: "dash" }
    }
}

schema RequiredScalars {
    port: int { required: true }
    ratio: float { required: true }
    verbose: bool { required: true }
    mode: enum(FAST, SAFE) { required: true }
    addr: ipv4 { required: true }
    use_tls: bool { default: false }
    tls_port: int { required_if: use_tls == true }
}

schema Conditions {
    mode: enum(BASIC, ADVANCED) { default: BASIC }
    adv_key: string { required_if: mode == ADVANCED }
    kind: string { default: "plain" }
    kind_val: string { required_if: kind == "special" }
    gw: ipv4 { default: "0.0.0.0" }
    gw_name: string { required_if: gw == "10.0.0.1" }
    section net {
        proto: enum(TCP, UDP) { default: TCP }
        udp_buf: int { required_if: proto == UDP }
    }
}

// Arrays of structs nested inside a section: [[NestedArrays.deps.github]]
schema NestedArrays {
    section deps {
        github: GithubSource[]
    }
}
